d" style="display:none"><h2>Usuário conectado</h2><div class="user"><div>Nome:</div><div class="user-name" id="userName">—</div><div class="session-id" id="sessionId"></div></div><label for="points">Pontos da coleta</label><input id="points" type="number" min="1" step="1" value="1" inputmode="numeric"><button class="primary" id="registerBtn">Registrar pontos</button><button class="danger" id="closeBtn">Encerrar sessão sem pontuar</button><div class="message" id="message"></div></section><section class="card details"><strong>Machine ID:</strong> <code>%MACHINE_ID%</code><br><strong>Event ID:</strong> <code>%EVENT_ID%</code><br><strong>MAC:</strong> <code>%MAC%</code><br><strong>IP:</strong> <code>%IP%</code></section></main><script>const SUPABASE_URL='%SUPABASE_URL%',SUPABASE_KEY='%SUPABASE_KEY%',MACHINE_ID='%MACHINE_ID%',MACHINE_TOKEN='%MACHINE_TOKEN%',EVENT_ID='%EVENT_ID%';let currentSession=null,busy=false;const $=id=>document.getElementById(id);function setStatus(t,w=false){$('status').textContent=t;$('status').className='status'+(w?' waiting':'')}function setMessage(t){$('message').textContent=t}function showWaiting(){currentSession=null;$('sessionCard').style.display='none';setStatus('Aguardando usuário...',true);setMessage('')}function showSession(d){currentSession=d;$('sessionCard').style.display='block';$('userName').textContent=d.nome||'Usuário';$('sessionId').textContent='Sessão: '+d.session_id;setStatus(d.status==='processando'?'Processando coletas pendentes':'Usuário conectado')}async function rpc(n,b){const r=await fetch(SUPABASE_URL+'/rest/v1/rpc/'+n,{method:'POST',headers:{apikey:SUPABASE_KEY,Authorization:'Bearer '+SUPABASE_KEY,'Content-Type':'application/json'},body:JSON.stringify(b)});const t=await r.text();let d=null;try{d=t?JSON.parse(t):null}catch{d=t}if(!r.ok)throw new Error(typeof d==='object'?(d.message||d.hint||JSON.stringify(d)):String(d));return d}async function checkSession(){if(busy)return;try{const d=await rpc('get_active_session',{p_machine_id:MACHINE_ID,p_device_token:MACHINE_TOKEN});const s=Array.isArray(d)?d[0]:d;if(s&&s.session_id){if(!currentSession||currentSession.session_id!==s.session_id||currentSession.nome!==s.nome||currentSession.status!==s.status)showSession(s)}else if(currentSession)showWaiting()}catch(e){console.error(e);setStatus('Erro ao consultar a sessão',true);setMessage(e.message||'Falha na comunicação com o Supabase.')}}async function registerPoints(){if(!currentSession||busy)return;const p=Number($('points').value);if(!Number.isInteger(p)||p<1){setMessage('Digite uma quantidade de pontos válida.');return}busy=true;$('registerBtn').disabled=$('closeBtn').disabled=true;setMessage('Registrando coleta...');try{await rpc('registrar_coleta',{p_machine_id:MACHINE_ID,p_device_token:MACHINE_TOKEN,p_session_id:currentSession.session_id,p_tipo_coleta:'unitaria',p_quantidade_real:p,p_quantidade_estimada:null,p_peso_real_gramas:null,p_peso_estimado_gramas:null});setMessage('Pontos registrados com sucesso.');setTimeout(showWaiting,700)}catch(e){setMessage(e.message||'Não foi possível registrar os pontos.')}finally{busy=false;$('registerBtn').disabled=$('closeBtn').disabled=false}}async function closeSession(){if(!currentSession||busy)return;busy=true;$('registerBtn').disabled=$('closeBtn').disabled=true;setStatus('Processando coletas pendentes...',true);setMessage('Aguardando a máquina finalizar...');try{await rpc('encerrar_sessao_usuario',{p_session_id:currentSession.session_id});await checkSession()}catch(e){setMessage(e.message||'Não foi possível iniciar o encerramento.')}finally{busy=false;$('registerBtn').disabled=$('closeBtn').disabled=false}}function createQr(){new QRCode($('qrcode'),{text:JSON.stringify({machine_id:MACHINE_ID,event_id:EVENT_ID}),width:230,height:230,correctLevel:QRCode.CorrectLevel.M})}$('registerBtn').addEventListener('click',registerPoints);$('closeBtn').addEventListener('click',closeSession);createQr();checkSession();setInterval(checkSession,1500);</script></body></html>)HTML";
